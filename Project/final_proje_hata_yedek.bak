```{r}
#| label: kurulum
#| include: false

library(readr)
library(dplyr)
library(tidyr)
library(stringr)
library(ggplot2)

proje_yolu <- function(path) {
  if (file.exists(path)) {
    path
  } else {
    file.path("Project", path)
  }
}
ham_veri <- read_csv(proje_yolu("data/02_m4_sentetik_ham_veri.csv"), show_col_types = FALSE)
veri <- read_csv(proje_yolu("data/03_m4_temiz_veri.csv"), show_col_types = FALSE)
uzun_veri <- read_csv(proje_yolu("data/04_m4_uzun_veri.csv"), show_col_types = FALSE)
degisken_ozeti <- read_csv(proje_yolu("outputs/tables/01_degisken_ozeti.csv"), show_col_types = FALSE)
faktor_ozetleri <- read_csv(proje_yolu("outputs/tables/02_faktor_ozetleri.csv"), show_col_types = FALSE)
kombinasyon_ozetleri <- read_csv(proje_yolu("outputs/tables/03_kombinasyon_ozetleri.csv"), show_col_types = FALSE)
karar_tablosu <- read_csv(proje_yolu("outputs/tables/04_coklu_yanit_karar_tablosu.csv"), show_col_types = FALSE)

tablo_html <- function(x, caption = NULL, digits = 2) {
  knitr::kable(
    x,
    format = "html",
    caption = caption,
    digits = digits,
    table.attr = 'class="table table-striped table-hover table-sm"'
  )
}

duzey_tr <- function(x) {
  dplyr::recode(x, "Dusuk" = "DC<EC<k", "Yuksek" = "YC<ksek", "Kisa" = "KD1sa", "Uzun" = "Uzun")
}

ham_veri_tablo <- ham_veri |>
  transmute(
    `Deney sD1rasD1` = Run,
    `Standart sD1ra` = Std,
    `Tekrar` = Rep,
    `A - AktC<atC6r sC<rC<EC<` = duzey_tr(A),
    `B - Darbe sC<resi` = duzey_tr(B),
    `C - Hareketli kC<tle` = duzey_tr(C),
    `D - SC6nC<mleme` = duzey_tr(D),
    `Sapma` = Sapma,
    `Toparlanma` = Toparlanma,
    `GerC'ekC'ilik skoru` = Skor,
    `Enerji yC<kC<` = Enerji
  )

veri_onizleme_tablo <- ham_veri_tablo |> head(8)

degisken_ozeti_tablo <- degisken_ozeti |>
  transmute(
    `GC6zlem sayD1sD1` = gozlem_sayisi,
    `Sapma ort.` = sapma_ortalama,
    `Sapma min.` = sapma_min,
    `Sapma maks.` = sapma_max,
    `Toparlanma ort.` = toparlanma_ortalama,
    `Toparlanma min.` = toparlanma_min,
    `Toparlanma maks.` = toparlanma_max,
    `Skor ort.` = skor_ortalama,
    `Skor min.` = skor_min,
    `Skor maks.` = skor_max,
    `Enerji ort.` = enerji_ortalama,
    `Enerji min.` = enerji_min,
    `Enerji maks.` = enerji_max
  )

faktor_ozetleri_tablo <- faktor_ozetleri |>
  mutate(
    faktor = recode(
      faktor,
      "A" = "AktC<atC6r sC<rC<EC<",
      "B" = "Darbe sC<resi",
      "C" = "Hareketli kC<tle",
      "D" = "SC6nC<mleme"
    ),
    seviye = duzey_tr(seviye)
  ) |>
  transmute(
    `FaktC6r` = faktor,
    `Seviye` = seviye,
    `Ortalama sapma` = sapma_ort,
    `Ortalama toparlanma` = toparlanma_ort,
    `Ortalama skor` = skor_ort,
    `Ortalama enerji` = enerji_ort
  )

eksik_deger_tablo <- veri |>
  summarise(across(everything(), ~ sum(is.na(.x)))) |>
  pivot_longer(everything(), names_to = "DeDiEken", values_to = "Eksik deDer sayD1sD1")
```

